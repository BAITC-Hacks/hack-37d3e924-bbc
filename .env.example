# Brev Docker deployment. Copy to .env; do not commit .env or credentials.
APP_PROFILE=brev
# Path on the SERVER running Docker, not on the laptop.
MEETING_MODEL_DIR=./models
BREV_BIND_ADDRESS=127.0.0.1
BREV_HOST_PORT=8000
MAX_UPLOAD_BYTES=104857600
AI_CONTEXT_TOKENS=2048
AI_MAX_NEW_TOKENS=512
AI_THREADS=4

# Direct launch without Docker (Compose uses its own /data and internal :8000).
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATA_DIR=.local/app
# DATABASE_PATH=.local/app/meetings.sqlite3
# AI_STATE_DIR=.local/app/ai-private
# AI_STAGE_TIMEOUT=3600

# Optional separate CUDA profile; supply actual local GPU model directories.
# AI_ASR=mixed_ctc
# AI_ASR_PATH=/models/asr
# AI_DIARIZER=community1
# AI_DIARIZATION_PATH=/models/community1
# AI_LLM=transformers
# AI_LLM_PATH=/models/qwen14b
# AI_DEVICE=cuda
# AI_QUANTIZATION=nf4
