# Proposed shared baseline; application support is not implemented yet.
# API and worker must use the same server paths / shared volume.
DATA_DIR=/data
DATABASE_PATH=/data/meetings.sqlite3
PIPELINE_MODE=real
MAX_UPLOAD_BYTES=104857600
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Enable only after preparing local weights. These flags alone do not prove no egress.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# AI-specific model paths and verified settings are documented by participant 1 in ai/.
# Do not add secrets or a cloud fallback for meeting data.
