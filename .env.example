# Copy to .env; scripts/manage.py loads KEY=value lines without executing shell code.
# API and worker share this local directory. Keep it outside a publicly served folder.
DATA_DIR=.local/app
# Optional override; otherwise DATA_DIR/meetings.sqlite3
# DATABASE_PATH=.local/app/meetings.sqlite3
MAX_UPLOAD_BYTES=104857600
BACKEND_PORT=8000
# Profile is selected explicitly by make up PROFILE=mac|cuda|fixture.
# Mac: the existing prototype model directory (asr/, diarization/, llm/).
# MEETING_MODEL_DIR=/absolute/path/to/models
# Linux GPU example (prepare weights separately; see ai/README.md):
# AI_ASR=mixed_ctc
# AI_ASR_PATH=/models/mixed-ctc
# AI_DIARIZER=community1
# AI_DIARIZATION_PATH=/models/community1
# AI_LLM=transformers
# AI_LLM_PATH=/models/qwen14b
# AI_DEVICE=cuda
# AI_QUANTIZATION=nf4
# Never put credentials in this example or commit .env.
