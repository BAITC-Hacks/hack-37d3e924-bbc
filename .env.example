# Copy to .env; scripts/manage.py loads KEY=value without executing shell code.
# API and worker share local storage. Never expose this directory as static files.
DATA_DIR=.local/app
# DATABASE_PATH=.local/app/meetings.sqlite3
MAX_UPLOAD_BYTES=104857600
BACKEND_PORT=8000

# Original model bundle, assembled in place by scripts/prepare_repo_models.py.
# Override with an absolute path to an existing verified bundle if needed.
MEETING_MODEL_DIR=models

# Select mac|cuda|windows|fixture explicitly via scripts/manage.py.
# start-windows.cmd selects available CUDA or CPU before processing starts.
# Windows defaults; no automatic model fallback.
# AI_CONTEXT_TOKENS=2048
# AI_MAX_NEW_TOKENS=512
# AI_STAGE_TIMEOUT=3600

# Linux CUDA needs separately prepared local weights and an explicit profile.
# AI_ASR=mixed_ctc
# AI_ASR_PATH=/models/mixed-ctc
# AI_DIARIZER=community1
# AI_DIARIZATION_PATH=/models/community1
# AI_LLM=transformers
# AI_LLM_PATH=/models/qwen14b
# AI_DEVICE=cuda
# AI_QUANTIZATION=nf4
# Never put credentials in this example or commit .env.
