{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MeetingPipelineInputV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meeting_id",
    "audio_path",
    "meeting_datetime",
    "timezone",
    "participants"
  ],
  "properties": {
    "meeting_id": {
      "type": "string",
      "minLength": 1
    },
    "audio_path": {
      "type": "string",
      "minLength": 1
    },
    "meeting_datetime": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "speaker_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "speaker_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
