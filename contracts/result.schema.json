{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MeetingPipelineResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "meeting_id",
    "meeting_datetime",
    "timezone",
    "participants",
    "segments",
    "tasks",
    "summary",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "meeting_id": {
      "type": "string",
      "minLength": 1
    },
    "meeting_datetime": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "speaker_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "speaker_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "speaker_id",
          "start",
          "end",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "speaker_id": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "assignee_id",
          "due_date",
          "source_segment_ids",
          "needs_review"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "assignee_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "due_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "source_segment_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "needs_review": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "assignee_id": {
                  "type": "null"
                }
              }
            },
            "then": {
              "properties": {
                "needs_review": {
                  "const": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "due_date": {
                  "type": "null"
                }
              }
            },
            "then": {
              "properties": {
                "needs_review": {
                  "const": true
                }
              }
            }
          }
        ]
      }
    },
    "summary": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
